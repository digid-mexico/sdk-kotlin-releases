    </license>
  </licenses>
  <developers>
    <developer>
      <id>komputing</id>
      <name>Komputing</name>
      <email></email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git://github.com/komputing/KHash.git</connection>
